{
    "production": false,
    "apiUrl": "http://localhost:5555",
    "dnsNameservers": [
        {
            "ns": "ns1.demo.edgecdnx.com",
            "routeResolver": "http://ns1.demo.edgecdnx.com:8081/route"
        },
        {
            "ns": "ns2.demo.edgecdnx.com",
            "routeResolver": "http://ns1.demo.edgecdnx.com:8081/route"
        }
    ],
    "auth": {
        "oidc": {
            "issuer": "https://auth.demo.edgecdnx.com/realms/edgecdnx",
            "token": "https://auth.demo.edgecdnx.com/realms/edgecdnx/protocol/openid-connect/token",
            "clientId": "edgecdnx",
            "scope": "openid profile email",
            "requireHttps": true,
            "redirectUri": "http://localhost:4200/callback"
        },
        "allowSignup": true,
        "adminGroups": ["admin"]
    }
}